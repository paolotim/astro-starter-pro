---
interface Props {
  color?: string;
  class?: string;
}

const { color = "#8b5cf6", class: className = "" } = Astro.props;
---

<div
  class:list={["wireframe-wormhole", className]}
  data-color={color}
  style="position: relative; width: 100%; height: 100%;"
>
</div>

<script>
  import * as THREE from "three";

  function initWormhole(container: HTMLElement) {
    const color = container.dataset.color || "#8b5cf6";

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      60,
      container.clientWidth / container.clientHeight,
      0.1,
      1000,
    );
    camera.position.set(0, 0, 6);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    const threeColor = new THREE.Color(color);
    const wormholeGroup = new THREE.Group();

    // --- Build the wormhole tunnel from rings + longitudinal lines ---
    const ringCount = 30;
    const segmentsPerRing = 48;
    const tunnelDepth = 20;
    const minRadius = 0.3;
    const maxRadius = 3.5;

    // Store ring vertex positions for longitudinal connections
    const ringVertices: THREE.Vector3[][] = [];

    for (let i = 0; i < ringCount; i++) {
      const t = i / (ringCount - 1); // 0 at mouth, 1 at far end
      const z = -t * tunnelDepth;

      // Radius shrinks as we go deeper — creates the funnel/vortex shape
      const radius = maxRadius * Math.pow(1 - t, 0.6) + minRadius;

      // Opacity fades deeper into the tunnel
      const opacity = 1.0 - t * 0.7;

      const ringGeo = new THREE.BufferGeometry();
      const points: THREE.Vector3[] = [];

      for (let j = 0; j <= segmentsPerRing; j++) {
        const angle = (j / segmentsPerRing) * Math.PI * 2;
        const x = Math.cos(angle) * radius;
        const y = Math.sin(angle) * radius;
        points.push(new THREE.Vector3(x, y, z));
      }

      ringVertices.push(points.slice(0, segmentsPerRing)); // store without closing duplicate

      ringGeo.setFromPoints(points);
      const ringMat = new THREE.LineBasicMaterial({
        color: threeColor,
        opacity: opacity,
        transparent: true,
      });
      const ring = new THREE.Line(ringGeo, ringMat);
      wormholeGroup.add(ring);
    }

    // Longitudinal lines connecting rings (every Nth segment)
    const longiStep = 4; // connect every 4th vertex
    for (let j = 0; j < segmentsPerRing; j += longiStep) {
      const longiPoints: THREE.Vector3[] = [];
      for (let i = 0; i < ringCount; i++) {
        longiPoints.push(ringVertices[i][j]);
      }
      const longiGeo = new THREE.BufferGeometry().setFromPoints(longiPoints);
      const longiMat = new THREE.LineBasicMaterial({
        color: threeColor,
        opacity: 0.3,
        transparent: true,
      });
      const longiLine = new THREE.Line(longiGeo, longiMat);
      wormholeGroup.add(longiLine);
    }

    // Vertex dots at the mouth ring
    const mouthRing = ringVertices[0];
    const dotGeo = new THREE.SphereGeometry(0.04, 8, 8);
    const dotMat = new THREE.MeshBasicMaterial({ color: threeColor });
    for (let j = 0; j < mouthRing.length; j += longiStep) {
      const dot = new THREE.Mesh(dotGeo, dotMat);
      dot.position.copy(mouthRing[j]);
      wormholeGroup.add(dot);
    }

    scene.add(wormholeGroup);

    let time = 0;
    let raf: number;

    function animate() {
      raf = requestAnimationFrame(animate);
      time += 0.004;

      // Slow rotation around the z-axis (looking into the tunnel)
      wormholeGroup.rotation.z = 0.3 * time;

      // Gentle tilt for depth
      wormholeGroup.rotation.x = Math.sin(time * 0.5) * 0.15;
      wormholeGroup.rotation.y = Math.cos(time * 0.4) * 0.1;

      renderer.render(scene, camera);
    }
    animate();

    const onResize = () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    };
    window.addEventListener("resize", onResize);

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("resize", onResize);
      renderer.dispose();
      dotGeo.dispose();
      dotMat.dispose();
      wormholeGroup.traverse((obj) => {
        if (obj instanceof THREE.Line || obj instanceof THREE.Mesh) {
          obj.geometry.dispose();
          if (obj.material instanceof THREE.Material) obj.material.dispose();
        }
      });
      if (container.contains(renderer.domElement)) {
        container.removeChild(renderer.domElement);
      }
    };
  }

  document
    .querySelectorAll<HTMLElement>(".wireframe-wormhole")
    .forEach((el) => {
      if (!el.dataset.initialized) {
        el.dataset.initialized = "true";
        initWormhole(el);
      }
    });
</script>
