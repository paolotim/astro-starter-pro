---
interface Props {
  color?: string;
  class?: string;
}

const { color = "#facc15", class: className = "" } = Astro.props;
---

<div
  class:list={["wireframe-octahedron", className]}
  data-color={color}
  style="position: relative; width: 100%; height: 100%;"
>
</div>

<script>
  import * as THREE from "three";

  function initOctahedron(container: HTMLElement) {
    const color = container.dataset.color || "#facc15";

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(
      50,
      container.clientWidth / container.clientHeight,
      0.1,
      1000,
    );
    camera.position.set(-1.5, 1, 6);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({
      antialias: true,
      alpha: true,
      powerPreference: "high-performance",
    });
    renderer.setPixelRatio(window.devicePixelRatio);
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setClearColor(0x000000, 0);
    container.appendChild(renderer.domElement);

    // Octahedron with detail level 2 for a faceted crystal look
    const geometry = new THREE.OctahedronGeometry(2.5, 2);

    // Solid edge lines
    const edges = new THREE.EdgesGeometry(geometry);
    const edgeMaterial = new THREE.LineBasicMaterial({
      color: new THREE.Color(color),
      linewidth: 1,
    });
    const edgeLines = new THREE.LineSegments(edges, edgeMaterial);
    scene.add(edgeLines);

    // Semi-transparent wireframe overlay
    const wireframe = new THREE.WireframeGeometry(geometry);
    const wireMaterial = new THREE.LineBasicMaterial({
      color: new THREE.Color(color),
      opacity: 0.35,
      transparent: true,
    });
    const wireLines = new THREE.LineSegments(wireframe, wireMaterial);
    scene.add(wireLines);

    // Vertex dots (like the sphere)
    const positions = geometry.attributes.position;
    const vertexGroup = new THREE.Group();
    const dotGeo = new THREE.SphereGeometry(0.04, 10, 10);
    const dotMat = new THREE.MeshBasicMaterial({
      color: new THREE.Color(color),
    });
    const seen = new Set<string>();

    for (let i = 0; i < positions.count; i++) {
      const x = positions.getX(i);
      const y = positions.getY(i);
      const z = positions.getZ(i);
      const key = `${x.toFixed(4)},${y.toFixed(4)},${z.toFixed(4)}`;
      if (!seen.has(key)) {
        seen.add(key);
        const dot = new THREE.Mesh(dotGeo, dotMat);
        dot.position.set(x, y, z);
        vertexGroup.add(dot);
      }
    }
    scene.add(vertexGroup);

    let time = 0;
    let raf: number;

    function animate() {
      raf = requestAnimationFrame(animate);
      time += 0.003;
      edgeLines.rotation.x =
        wireLines.rotation.x =
        vertexGroup.rotation.x =
          0.6 * time;
      edgeLines.rotation.y =
        wireLines.rotation.y =
        vertexGroup.rotation.y =
          0.4 * time;
      edgeLines.rotation.z =
        wireLines.rotation.z =
        vertexGroup.rotation.z =
          0.1 * time;
      renderer.render(scene, camera);
    }
    animate();

    const onResize = () => {
      camera.aspect = container.clientWidth / container.clientHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(container.clientWidth, container.clientHeight);
    };
    window.addEventListener("resize", onResize);

    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("resize", onResize);
      renderer.dispose();
      geometry.dispose();
      edges.dispose();
      edgeMaterial.dispose();
      wireframe.dispose();
      wireMaterial.dispose();
      dotGeo.dispose();
      dotMat.dispose();
      if (container.contains(renderer.domElement)) {
        container.removeChild(renderer.domElement);
      }
    };
  }

  document
    .querySelectorAll<HTMLElement>(".wireframe-octahedron")
    .forEach((el) => {
      if (!el.dataset.initialized) {
        el.dataset.initialized = "true";
        initOctahedron(el);
      }
    });
</script>
